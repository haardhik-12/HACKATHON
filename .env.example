# =====================================================
# Mental Health Support System - Environment Config
# Copy this file to .env and fill in your values.
# =====================================================

# LLM Provider: "ollama" | "groq" | "openai" | "mock" (for demo/testing)
LLM_PROVIDER=mock

# Model name to use
# For Ollama: llama3, mistral, llama3.1, etc.
# For Groq: llama3-8b-8192, mixtral-8x7b-32768, etc.
MODEL_NAME=llama3

# Ollama base URL (if using local Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Groq API key (if using Groq cloud)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API key (if using Google AI)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI-compatible API (if using OpenAI or compatible endpoint)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Default country for crisis resources: US, UK, IN, AU, CA, GLOBAL
DEFAULT_CRISIS_COUNTRY=US

# Session timeout in seconds (default: 30 minutes)
SESSION_TIMEOUT=1800

# App secret key for API security
APP_SECRET_KEY=change-me-in-production

# Enable debug logging: true | false
DEBUG=false


LLM_PROVIDER=gemini
MODEL_NAME=gemini-2.5-flash
